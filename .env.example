# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only — never expose to the client).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted (used for OAuth redirects).
APP_URL="MY_APP_URL"

# NODE_ENV=production on the hosted deploy enables HSTS + the strict CSP.
NODE_ENV="development"

# ── Supabase Auth (recommended for production) ─────────────────────────────
# 1. Create a free project at https://supabase.com
# 2. Go to Project Settings → API Keys → copy the Project URL, the publishable
#    key (sb_publishable_...) and a secret key (sb_secret_...).
#    Use the NEW-format keys, not the legacy `anon` / `service_role` JWTs.
#    This project's legacy JWT keys are disabled — sending one gets
#    401 "Legacy API keys are disabled" from every Supabase API.
# 3. Enable Google OAuth: Authentication → Sign In / Providers → Google
#    - Set Authentication → URL Configuration → Site URL to your APP_URL, and
#      add your APP_URL to Redirect URLs. Without this, sign-in silently
#      returns users to localhost and the app looks broken only in production.
#
# A secret key is only shown once, at creation. If you lose it, create
# another and update this file; do not go back to a legacy service_role.
#
# Client (VITE_ prefixed — these get bundled into the frontend):
#   When set, Auth uses Supabase (real Google OAuth + bcrypt passwords).
#   When omitted, Auth falls back to local-only mode (salted SHA-256 client-side hash).
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Server (set these on your hosting provider, e.g. Render env vars — NOT in git):
#   When set, every /api/* request requires a valid Supabase session token.
#   This protects your GEMINI_API_KEY quota from anonymous abuse.
#   (The server also accepts VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY if
#   you configure them as regular env vars on the host.)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""

# ── Server-authoritative economy (required for billing + tier enforcement) ──
# SUPABASE_SERVICE_KEY: a secret key (sb_secret_..., Settings → API Keys). Grants
#   the server the right to grant/revoke Pro tier and manage the economy tables.
#   NEVER expose this to the client.
SUPABASE_SERVICE_KEY=""

# ── Razorpay (real-money Pro fast-pass, ₹99/month) ──────────────────────────
# 1. Create an account at https://razorpay.com, complete KYC.
# 2. Dashboard → Settings → API Keys → generate Key Id + Key Secret.
# 3. Add a webhook: https://your-app.onrender.com/api/billing/webhook
#    Secret below must match the webhook's secret. Event: payment.captured.
# Client-side publishable key (safe to expose):
VITE_RAZORPAY_KEY_ID=""
# Server-side secrets (Render env vars only):
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ── Web push (optional) ──────────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
# The opt-in button is hidden entirely while this is empty, so the app does
# not offer alerts it cannot deliver.
#
# Setting only the public key lets a device SUBSCRIBE (the endpoint and keys
# are stored in push_subscriptions), but nothing ever sends: the alert sender
# is not implemented and the private key has no consumer yet. Treat push as
# receive-only scaffolding until a sender exists.
VITE_VAPID_PUBLIC_KEY=
